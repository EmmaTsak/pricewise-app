generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups    ProductGroup[]
  products  Product[]
}

model ProductGroup {
  id             String   @id @default(cuid())
  name           String
  normalizedName String
  brand          String?
  size           String?
  imageUrl       String?

  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])

  products       Product[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([categoryId])
  @@index([normalizedName])
  @@unique([categoryId, normalizedName])
}

model Product {
  id             String   @id @default(cuid())

  name           String
  productKey     String   @db.VarChar(255)
  price          Decimal  @db.Decimal(6, 2)
  supermarket    String
  categoryName   String?

  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])

  photoURL       String?
  url            String?

  normalizedName String?
  size           String?

  productGroupId String?
  productGroup   ProductGroup? @relation(fields: [productGroupId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([productGroupId, supermarket])
  @@unique([productKey, supermarket])
  @@index([supermarket])
  @@index([categoryName])
  @@index([categoryId])
  @@index([productGroupId])
  @@index([normalizedName])
}