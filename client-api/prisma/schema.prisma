generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  brand       String?
  productKey  String
  price       Decimal  @db.Decimal(6,2)
  supermarket String
  category    String
  photoURL    String
  url         String?
  size        String?
  updatedAt   DateTime @updatedAt

  @@index([supermarket])
  @@index([category])
  @@index([productKey])
}