node_modules/
client-api/node_modules/
frontend/node_modules/

# =========================
# Environment variables
# =========================
.env
*.env
client-api/.env
frontend/.env

# Keep example env files
!.env.example
!*.env.example
!client-api/.env.example
!frontend/.env.example

# =========================
# Build outputs
# =========================
dist/
build/
client-api/dist/
frontend/dist/
frontend/dist-ssr/

# =========================
# Prisma generated files
# =========================
client-api/src/generated/prisma/
client-api/generated/prisma/

# =========================
# Logs
# =========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

frontend/logs/
frontend/*.log
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/lerna-debug.log*

# =========================
# Editor / IDE files
# =========================
.vscode/
.idea/

# Optional: allow recommended VS Code extensions
!.vscode/extensions.json
!frontend/.vscode/extensions.json

